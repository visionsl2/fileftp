{
  "name": "fileftp",
  "version": "1.2.3",
  "description": "文件上传下载浏览系统",
  "main": "server.js",
  "scripts": {
    "build": "babel app -d dist/app --copy-files && babel server.js -o dist/server.js && cp .env dist/.env",
    "start": "node dist/server.js",
    "dev": "nodemon server.js",
    "pkg": "pkg . --targets node22-linux-arm64 --output dist/fileftp-arm64"
  },
  "pkg": {
    "assets": [
      "app/views/**/*.ejs",
      "app/public/**/*"
    ]
  },
  "keywords": [
    "file",
    "upload",
    "download",
    "express",
    "mongodb"
  ],
  "bin": "server.js",
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.0.3",
    "ejs": "3.1.8",
    "express": "4.18.2",
    "express-rate-limit": "6.11.0",
    "express-session": "1.17.3",
    "fluent-ffmpeg": "^2.1.3",
    "formidable": "2.1.1",
    "jsonwebtoken": "9.0.0",
    "mongoose": "6.11.0",
    "multer": "1.4.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.29.0",
    "@babel/preset-env": "7.29.5",
    "@yao-pkg/pkg": "^6.20.0",
    "nodemon": "2.0.20",
    "ssh2": "^1.17.0"
  }
}
