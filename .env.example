# 服务配置
PORT=8002
NODE_ENV=development

# MongoDB配置
MONGODB_URI=mongodb://127.0.0.1:27017/fileftp

# JWT配置
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# 上传配置 - 支持任意磁盘路径
# Windows示例: D:/uploads 或 E:\\FileFTP\\uploads
# Linux示例: /home/user/uploads 或 /data/fileftp
# 相对路径会相对于项目根目录
UPLOAD_DIR=C:/Temp/uploads

MAX_FILE_SIZE=10224857600
MAX_CHUNK_SIZE=5242880
MAX_FILES_PER_REQUEST=10

# 存储配额 (字节)
DEFAULT_STORAGE_QUOTA=107374182400

# Session配置
SESSION_SECRET=your-session-secret-here

# ffmpeg路径（可选，用于视频缩略图生成，留空则自动检测系统PATH）
# Windows示例: C:/software/ffmpeg/bin/ffmpeg.exe
# Linux示例: /usr/bin/ffmpeg
FFMPEG_PATH=C:/software/ffmpeg/bin/ffmpeg.exe
# AI 自动分类配置
# AI_AUTO_CLASSIFY - 启用后上传图片自动 AI 分析分类（默认 false，需显式设为 true）
# AI_CLASSIFY_MODE - auto=上传后自动分析, manual=用户手动触发
AI_AUTO_CLASSIFY=true
AI_AUTO_ORGANIZE=true  # 自动归类+重命名（根据 AI 结果自动创建文件夹并移动文件）
AI_MONTHLY_LIMIT=20  # 普通用户每月 AI 分析上限（文件数），0=不限制，admin 不受限
# AI_CLASSIFY_MODE=auto
# AI 大模型配置（OpenAI 兼容 API，支持 GPT-4V / Claude / 通义千问 / Ollama 等）

# === 当前：Ollama (本地测试) ===
AI_PROVIDER=openai
AI_BASE_URL=http://160.0.6.9:11434/v1
AI_API_KEY=your-ai-api-key-here
AI_MODEL=gemma4:26b

# === 旧配置（注释保留，可切换）===
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.minimax.chat/v1
# AI_API_KEY=your-ai-api-key-here
# AI_MODEL=minimax-M3
