<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>管理后台 - 赛博网盘</title>
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:#f5f5f5;color:#333}
    .header{background:linear-gradient(135deg,#1a1a2e,#16213e);color:white;padding:16px 24px;display:flex;justify-content:space-between;align-items:center}
    .header h1{font-size:18px}.header a{color:#ccc;text-decoration:none;font-size:14px}
    .header a:hover{color:white}
    .container{max-width:1000px;margin:0 auto;padding:24px}
    .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px}
    .stat-card{background:white;border-radius:10px;padding:20px;box-shadow:0 2px 8px rgba(0,0,0,0.06)}
    .stat-label{font-size:13px;color:#888;margin-bottom:6px}
    .stat-value{font-size:28px;font-weight:700;color:#1a1a2e}
    .stat-sub{font-size:12px;color:#aaa;margin-top:4px}
    h2{font-size:16px;margin-bottom:12px;color:#333}
    table{width:100%;background:white;border-radius:10px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.06)}
    th,td{padding:12px 16px;text-align:left;font-size:14px}
    th{background:#f8f9fa;color:#666;font-weight:500}
    tr:not(:last-child) td{border-bottom:1px solid #f0f0f0}
    .badge{display:inline-block;padding:2px 8px;border-radius:8px;font-size:11px}
    .badge-admin{background:#ffd70033;color:#b8860b}
    .badge-user{background:#e8e8e8;color:#666}
    .bar-wrap{background:#eee;border-radius:4px;height:6px;margin-top:4px}
    .bar-fill{background:linear-gradient(90deg,#667eea,#764ba2);border-radius:4px;height:100%;transition:width .3s}
    .bar-fill.warn{background:linear-gradient(90deg,#f56565,#ed8936)}
  </style>
</head>
<body>
<div class="header">
  <h1>⚙️ 赛博网盘 管理后台</h1>
  <div>
    <a href="/files">← 返回文件管理</a>
  </div>
</div>
<div class="container">
  <div class="stats">
    <div class="stat-card">
      <div class="stat-label">本月分析次数</div>
      <div class="stat-value"><%= global.totalAnalyses %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">本月 Token 总量</div>
      <div class="stat-value"><%= global.totalTokens.toLocaleString() %></div>
      <div class="stat-sub">输入 <%= global.totalPromptTokens.toLocaleString() %> · 输出 <%= global.totalCompletionTokens.toLocaleString() %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">活跃用户</div>
      <div class="stat-value"><%= totalUsers %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">存储总量</div>
      <div class="stat-value"><%= formatFileSize(totalSize) %></div>
    </div>
  </div>

  <h2>用户 AI 用量明细（本月）</h2>
  <table>
    <thead>
      <tr><th>用户</th><th>角色</th><th>分析次数</th><th>Token 输入</th><th>Token 输出</th><th>总计</th><th>限额</th></tr>
    </thead>
    <tbody>
      <% userStats.forEach(function(s) { %>
      <tr>
        <td><%= s.username %></td>
        <td><span class="badge <%= s.role==='admin'?'badge-admin':'badge-user' %>"><%= s.role %></span></td>
        <td><%= s.count %></td>
        <td><%= s.promptTokens.toLocaleString() %></td>
        <td><%= s.completionTokens.toLocaleString() %></td>
        <td><strong><%= s.totalTokens.toLocaleString() %></strong></td>
        <td><%= s.role==='admin'?'∞':s.count+'/'+monthlyLimit+' 次' %></td>
        </td>
      </tr>
      <% }) %>
      <% if (userStats.length === 0) { %>
      <tr><td colspan="7" style="text-align:center;color:#999">本月暂无 AI 分析记录</td></tr>
      <% } %>
    </tbody>
  </table>
</div>
</body>
</html>
