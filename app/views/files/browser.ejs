<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - FileFTP</title>
  <link rel="stylesheet" href="/css/filebrowser.css">
</head>
<body>
  <div class="app-container">
    <header class="app-header">
      <div class="header-left">
        <h1 class="app-title">FileFTP</h1>
      </div>
      <div class="header-right">
        <span class="username"><%= user.username %></span>
        <span class="storage-info">
          <%= (user.storageUsed / 1024 / 1024).toFixed(1) %> / <%= (user.storageQuota / 1024 / 1024 / 1024).toFixed(1) %> GB
        </span>
        <a href="/auth/logout" class="btn-logout">退出</a>
      </div>
    </header>

    <main class="main-content">
      <div class="toolbar">
        <div class="toolbar-left">
          <button class="btn btn-primary" id="uploadBtn">
            <svg class="icon" viewBox="0 0 24 24"><path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z"/></svg>
            上传
          </button>
          <button class="btn" id="newFolderBtn">
            <svg class="icon" viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z"/></svg>
            新建文件夹
          </button>
        </div>
        <div class="toolbar-right">
          <div class="view-toggle">
            <button class="view-btn active" data-view="grid" title="网格视图">
              <svg class="icon" viewBox="0 0 24 24"><path d="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/></svg>
            </button>
            <button class="view-btn" data-view="list" title="列表视图">
              <svg class="icon" viewBox="0 0 24 24"><path d="M4 14h4v-4H4v4zm0 5h4v-4H4v4zM4 9h4V5H4v4zm5 5h12v-4H9v4zm0 5h12v-4H9v4zM9 5v4h12V5H9z"/></svg>
            </button>
          </div>
          <button class="btn btn-refresh" id="refreshBtn" title="刷新">
            <svg class="icon" viewBox="0 0 24 24"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
          </button>
        </div>
      </div>

      <nav class="breadcrumb">
        <a href="/files" class="breadcrumb-item">全部文件</a>
        <% breadcrumb.forEach(function(item, index) { %>
          <span class="breadcrumb-separator">/</span>
          <% if (index === breadcrumb.length - 1) { %>
            <span class="breadcrumb-item current"><%= item.name %></span>
          <% } else { %>
            <a href="/files?folder=<%= item.id %>" class="breadcrumb-item"><%= item.name %></a>
          <% } %>
        <% }) %>
      </nav>

      <div class="file-list-container" id="fileListContainer">
        <div class="file-list" id="fileList" data-view="grid">
          <% if (folders.length === 0 && files.length === 0) { %>
            <div class="empty-state">
              <svg class="empty-icon" viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-1 12H5c-.55 0-1-.45-1-1V9c0-.55.45-1 1-1h14c.55 0 1 .45 1 1v8c0 .55-.45 1-1 1z"/></svg>
              <p>文件夹为空</p>
              <p class="empty-hint">点击"上传"按钮添加文件，或创建新文件夹</p>
            </div>
          <% } %>

          <% folders.forEach(function(folder) { %>
            <div class="file-item folder-item" data-type="folder" data-id="<%= folder._id %>">
              <div class="file-icon folder-icon">
                <svg viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
              </div>
              <div class="file-name"><%= folder.name %></div>
              <div class="file-actions">
                <button class="action-btn rename-folder" data-id="<%= folder._id %>" title="重命名">
                  <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                </button>
                <button class="action-btn delete-folder" data-id="<%= folder._id %>" title="删除">
                  <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                </button>
              </div>
            </div>
          <% }) %>

          <% files.forEach(function(file) { %>
            <% const isImage = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.svg', '.ico'].includes(file.extension.toLowerCase()); %>
            <div class="file-item file-item-row" data-type="file" data-id="<%= file._id %>" data-image="<%= isImage %>">
              <% if (isImage) { %>
              <div class="file-thumb-container" data-full-url="/files/<%= file._id %>/preview">
                <img src="/files/<%= file._id %>/thumb" class="file-thumb" alt="<%= file.originalName %>" loading="lazy">
              </div>
              <% } else { %>
              <div class="file-icon <%= getFileIconClass(file.extension) %>">
                <%- getFileIcon(file.extension) %>
              </div>
              <% } %>
              <div class="file-name" title="<%= file.originalName %>"><%= file.originalName %></div>
              <div class="file-size"><%= formatFileSize(file.size) %></div>
              <div class="file-date"><%= formatDate(file.updatedAt) %></div>
              <div class="file-actions">
                <a href="/files/<%= file._id %>/download" class="action-btn download" title="下载">
                  <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
                </a>
                <button class="action-btn delete-file" data-id="<%= file._id %>" title="删除">
                  <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                </button>
              </div>
            </div>
          <% }) %>
        </div>
      </div>
    </main>

    <div class="upload-panel" id="uploadPanel">
      <div class="panel-header">
        <span>上传进度</span>
        <button class="close-panel" id="closeUploadPanel">&times;</button>
      </div>
      <div class="upload-list" id="uploadList"></div>
    </div>
  </div>

  <form id="uploadForm" enctype="multipart/form-data" style="display: none;">
    <input type="file" name="files" multiple id="fileInput" accept="*">
    <input type="hidden" name="folder" value="<%= currentFolder || '' %>">
  </form>

  <!-- 图片预览模态框 -->
  <div id="imagePreviewModal" class="modal">
    <span class="modal-close">&times;</span>
    <img class="modal-content" id="previewImg">
    <div class="modal-footer">
      <span id="previewFileName"></span>
      <a href="#" class="btn-preview-download" id="previewDownloadBtn" target="_blank">
        <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        下载
      </a>
    </div>
  </div>

  <!-- 拖拽上传区域 -->
  <div id="dropZone" class="drop-zone">
    <div class="drop-zone-content">
      <svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
      <p>将文件拖拽到此处上传</p>
      <span class="drop-hint">支持单个或多个文件</span>
    </div>
  </div>

  <script src="/js/filebrowser.js"></script>
</body>
</html>