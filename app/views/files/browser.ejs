<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - 赛博网盘</title>
  <!-- 静态资源带 ?v= 版本号，部署时手动 bump，强制浏览器刷新缓存 -->
  <link rel="stylesheet" href="/css/filebrowser.css?v=20260707-1">
</head>
<body>
  <div class="app-container">
    <%- include('_navbar', { user: user, aiQuota: aiQuota, currentPage: 'files' }) %>

    <main class="main-content">
      <div class="layout">
        <aside class="sidebar" id="sidebar">
          <div class="sidebar-header">
            <span>📁 文件夹</span>
            <button class="sidebar-toggle" id="sidebarToggle" title="折叠">◀</button>
          </div>
          <div class="folder-tree sidebar-tree" id="sidebarTree">
            <div class="folder-item root selected" data-id="">
              <span class="folder-icon">📂</span>
              <span class="folder-name">全部文件</span>
            </div>
          </div>
        </aside>
        <!-- 右键菜单（侧边栏文件夹） -->
        <div class="context-menu" id="folderContextMenu" style="display:none">
          <div class="context-menu-item" data-action="rename">
            <span class="context-menu-icon">✏️</span> 重命名
          </div>
          <div class="context-menu-item" data-action="merge">
            <span class="context-menu-icon">📁</span> 合并到...
          </div>
          <div class="context-menu-divider"></div>
          <div class="context-menu-item danger" data-action="delete">
            <span class="context-menu-icon">🗑️</span> 删除
          </div>
        </div>

        <!-- 合并目标选择 modal -->
        <div id="mergeFolderModal" class="modal">
          <div class="modal-dialog modal-md">
            <div class="modal-header">
              <h3 id="mergeFolderTitle">合并文件夹</h3>
              <button class="modal-close-btn" id="closeMergeFolderModal">&times;</button>
            </div>
            <div class="modal-body">
              <div class="merge-info" id="mergeInfo"></div>
              <div class="merge-target-list" id="mergeTargetList">
                <div class="merge-loading">加载中...</div>
              </div>
            </div>
            <div class="modal-footer">
              <button class="btn" id="cancelMergeFolderBtn">取消</button>
              <button class="btn btn-primary" id="confirmMergeFolderBtn" disabled>确定</button>
            </div>
          </div>
        </div>

        <div class="content-area" id="contentArea">
      <div class="toolbar">
        <div class="toolbar-left">
          <button class="btn btn-primary" id="uploadBtn">
            <svg class="icon" viewBox="0 0 24 24"><path d="M9 16h6v-6h4l-7-7-7 7h4zm-4 2h14v2H5z"/></svg>
            上传
          </button>
          <button class="btn" id="newFolderBtn">
            <svg class="icon" viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-1 8h-3v3h-2v-3h-3v-2h3V9h2v3h3v2z"/></svg>
            新建文件夹
          </button>
          <button class="btn" id="aiAnalyzeBtn">
            <svg class="icon" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
            智能整理
          </button>
          <div class="batch-actions" id="batchActions" style="display: none;">
            <button class="btn" id="moveSelectedBtn">
              <svg class="icon" viewBox="0 0 24 24"><path d="M10 9h4V6h3l-5-5-5 5h3v3zm-1 1H6V7l-5 5 5 5v-3h3v-4zm14 2l-5-5v3h-3v4h3v3l5-5zm-9 3h-4v3H7l5 5 5-5h-3v-3z"/></svg>
              移动到
            </button>
            <button class="btn" id="shareSelectedBtn">
              <svg class="icon" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
              分享
            </button>
            <span class="selected-count" id="selectedCount">已选择 0 项</span>
          </div>
        </div>
        <div class="toolbar-right">
          <div class="view-toggle">
            <button class="view-btn active" data-view="grid" title="网格视图">
              <svg class="icon" viewBox="0 0 24 24"><path d="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/></svg>
            </button>
            <button class="view-btn" data-view="list" title="列表视图">
              <svg class="icon" viewBox="0 0 24 24"><path d="M4 14h4v-4H4v4zm0 5h4v-4H4v4zM4 9h4V5H4v4zm5 5h12v-4H9v4zm0 5h12v-4H9v4zM9 5v4h12V5H9z"/></svg>
            </button>
          </div>
          <button class="btn btn-refresh" id="refreshBtn" title="刷新">
            <svg class="icon" viewBox="0 0 24 24"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
          </button>
        </div>
      </div>

      <nav class="breadcrumb">
        <a href="/files" class="breadcrumb-item">全部文件</a>
        <% breadcrumb.forEach(function(item, index) { %>
          <span class="breadcrumb-separator">/</span>
          <% if (index === breadcrumb.length - 1) { %>
            <span class="breadcrumb-item current"><%= item.name %></span>
          <% } else { %>
            <a href="/files?folder=<%= item.id %>" class="breadcrumb-item"><%= item.name %></a>
          <% } %>
        <% }) %>
      </nav>

      <% if (recentFiles && recentFiles.length > 0) { %>
      <div class="recent-bar" id="recentBar">
        <span class="recent-label">最近上传</span>
        <div class="recent-scroll">
          <% recentFiles.forEach(function(f) { %>
          <% const rIsImage = ['.jpg','.jpeg','.png','.gif','.bmp','.webp'].includes(f.extension.toLowerCase()); %>
          <% const rIsVideo = ['.mp4','.avi','.mov','.mkv','.webm'].includes(f.extension.toLowerCase()); %>
          <div class="recent-item" data-id="<%= f._id %>" data-type="<%= rIsVideo ? 'video' : (rIsImage ? 'image' : 'file') %>"
               data-url="<%= rIsVideo ? '/files/' + f._id + '/stream' : (rIsImage ? '/files/' + f._id + '/preview' : '/files/' + f._id + '/download') %>"
               data-folder="<%= f.folder || '' %>">
            <% if (rIsImage || (rIsVideo && f.thumb)) { %>
            <img src="/files/<%= f._id %>/thumb" class="recent-thumb" loading="lazy">
            <% if (rIsVideo) { %><div class="recent-play">▶</div><% } %>
            <% } else { %>
            <div class="recent-icon"><%- getFileIcon(f.extension) %></div>
            <% } %>
            <div class="recent-name" title="<%= f.originalName %>"><%= f.originalName.length > 10 ? f.originalName.slice(0,10) + '...' : f.originalName %></div>
            <% if (f.aiAnalysis && f.aiAnalysis.category) { %>
            <div class="recent-badge"><%= f.aiAnalysis.category %></div>
            <% } %>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <div class="file-list-container" id="fileListContainer">
        <div class="file-list" id="fileList" data-view="grid" data-page="<%= pagination.page %>" data-total-pages="<%= pagination.totalPages %>" data-folder="<%= currentFolder || '' %>">
          <% if (folders.length === 0 && files.length === 0) { %>
            <div class="empty-state">
              <svg class="empty-icon" viewBox="0 0 24 24"><path d="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-1 12H5c-.55 0-1-.45-1-1V9c0-.55.45-1 1-1h14c.55 0 1 .45 1 1v8c0 .55-.45 1-1 1z"/></svg>
              <p>文件夹为空</p>
              <p class="empty-hint">点击"上传"按钮添加文件，或创建新文件夹</p>
            </div>
          <% } %>

          <% folders.forEach(function(folder) { %>
            <div class="file-item folder-item" data-type="folder" data-id="<%= folder._id %>" data-selectable="true" data-droppable="true">
              <div class="file-icon folder-icon">
                <svg viewBox="0 0 24 24"><path d="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg>
              </div>
              <div class="file-name"><%= folder.name %></div>
              <div class="file-actions">
                <button class="action-btn rename-folder" data-id="<%= folder._id %>" title="重命名">
                  <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                </button>
                <button class="action-btn delete-folder" data-id="<%= folder._id %>" title="删除">
                  <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                </button>
              </div>
            </div>
          <% }) %>

          <% files.forEach(function(file) { %>
            <% const isImage = ['.jpg', '.jpeg', '.png', '.gif', '.bmp', '.webp', '.svg', '.ico'].includes(file.extension.toLowerCase()); %>
            <% const isVideo = ['.mp4', '.avi', '.mov', '.wmv', '.flv', '.mkv', '.webm', '.m4v', '.3gp'].includes(file.extension.toLowerCase()); %>
            <% const hasThumb = file.thumb && file.thumb.path; %>
            <div class="file-item file-item-row" data-type="file" data-id="<%= file._id %>" data-image="<%= isImage %>" data-video="<%= isVideo %>" draggable="true">
              <input type="checkbox" class="file-checkbox" data-id="<%= file._id %>">
              <% if (isImage || (isVideo && hasThumb)) { %>
              <div class="file-thumb-container" data-full-url="<%= isVideo ? '/files/' + file._id + '/stream' : '/files/' + file._id + '/preview' %>" data-type="<%= isVideo ? 'video' : 'image' %>">
                <% if (isVideo) { %>
                <div class="video-play-overlay">
                  <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
                </div>
                <% } %>
                <img src="/files/<%= file._id %>/thumb" class="file-thumb" alt="<%= file.originalName %>" loading="lazy" width="64" height="64"
                     onerror="this.onerror=null; this.style.display='none'; this.parentElement.classList.add('thumb-failed'); this.parentElement.setAttribute('data-fallback-icon', '<%= file.extension.toUpperCase().replace(/^./, '') %>');">
              </div>
              <% } else { %>
              <div class="file-icon <%= getFileIconClass(file.extension) %>">
                <%- getFileIcon(file.extension) %>
              </div>
              <% } %>
              <div class="file-name" title="<%= file.originalName %>"><%= file.originalName %></div>
              <% if (file.aiAnalysis && file.aiAnalysis.analyzed) { %>
              <div class="file-ai-info">
                <span class="ai-category-badge" title="置信度 <%= file.aiAnalysis.confidence %>%"><%= file.aiAnalysis.category %></span>
                <% if (file.aiAnalysis.summary) { %>
                <span class="ai-summary"><%= file.aiAnalysis.summary %></span>
                <% } %>
              </div>
              <% } %>
              <div class="file-size"><%= formatFileSize(file.size) %></div>
              <div class="file-date"><%= formatDate(file.updatedAt) %></div>
              <div class="file-actions">
                <a href="/files/<%= file._id %>/download" class="action-btn download" title="下载">
                  <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
                </a>
                <button class="action-btn delete-file" data-id="<%= file._id %>" title="删除">
                  <svg viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                </button>
              </div>
            </div>
          <% }) %>
          <% if (pagination.page < pagination.totalPages) { %>
          <div id="loadMoreSentinel" style="text-align:center; padding:20px; color:#999;">加载更多...</div>
          <% } %>
        </div>
      </div>
        </div><!-- /content-area -->
      </div><!-- /layout -->
    </main>

    <div class="upload-panel" id="uploadPanel">
      <div class="panel-header">
        <span>上传进度</span>
        <button class="close-panel" id="closeUploadPanel">&times;</button>
      </div>
      <div class="upload-list" id="uploadList"></div>
    </div>
  </div>

  <form id="uploadForm" enctype="multipart/form-data" style="display: none;">
    <input type="file" name="files" multiple id="fileInput" accept="*">
    <input type="hidden" name="folder" value="<%= currentFolder || '' %>">
  </form>

  <!-- 图片预览模态框（左右布局） -->
  <div id="imagePreviewModal" class="modal">
    <span class="modal-close">&times;</span>
    <div class="preview-container">
      <!-- 左侧大图 -->
      <div class="preview-left">
        <div class="preview-image-wrap">
          <img class="modal-content" id="previewImg">
          <button class="preview-fullscreen-btn" id="previewFullscreenBtn" title="全屏查看">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
              <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
            </svg>
          </button>
          <div class="preview-loading" id="previewLoading">
            <div class="spinner"></div>
          </div>
        </div>
      </div>

      <!-- 右侧信息面板 -->
      <div class="preview-right" id="previewRightPanel">
        <div class="preview-section preview-header-section">
          <div class="preview-name-row">
            <h3 class="preview-filename" id="previewFileName">文件名</h3>
            <a href="#" class="btn-preview-download" id="previewDownloadBtn" target="_blank">
              <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
              <span>下载</span>
            </a>
          </div>
        </div>

        <div class="preview-section">
          <div class="preview-label">📂 路径</div>
          <div class="preview-folder-edit">
            <span class="preview-folder-path" id="previewFolderPath">—</span>
            <button class="preview-folder-edit-btn" id="previewFolderEditBtn" title="修改位置">✏️</button>
          </div>
        </div>

        <div class="preview-section preview-ai-section">
          <div class="preview-label-row">
            <div class="preview-label">AI 分析</div>
            <button class="preview-reanalyze-btn" id="previewReanalyzeBtn" title="重新调用 AI 分析">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="currentColor"><path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/></svg>
              <span>重新分析</span>
            </button>
          </div>
          <div class="preview-ai-fields" id="previewAiFields">
            <div class="preview-ai-field">
              <select class="preview-category-select" id="previewCategorySelect">
                <option value="人物">人物</option>
                <option value="动物">动物</option>
                <option value="风景">风景</option>
                <option value="食物">食物</option>
                <option value="交通">交通</option>
                <option value="建筑">建筑</option>
                <option value="电子">电子</option>
                <option value="文档">文档</option>
                <option value="截图">截图</option>
                <option value="其他">其他</option>
              </select>
              <span class="preview-save-hint" id="previewCategorySave"></span>
            </div>
            <div class="preview-ai-field">
              <input type="text" class="preview-summary-input" id="previewSummaryInput" placeholder="一句话描述图片内容" maxlength="100">
              <span class="preview-save-hint" id="previewSummarySave"></span>
            </div>
            <div class="preview-ai-field">
              <div class="preview-tags" id="previewTags"></div>
              <div class="preview-tag-add">
                <input type="text" class="preview-tag-input" id="previewTagInput" placeholder="添加标签..." maxlength="20">
                <button class="preview-tag-add-btn" id="previewTagAddBtn">添加</button>
              </div>
              <span class="preview-save-hint" id="previewTagsSave"></span>
            </div>
          </div>
        </div>

        <div class="preview-section">
          <div class="preview-label">📊 文件信息</div>
          <div class="preview-meta-grid">
            <div class="preview-meta-item">
              <span class="preview-meta-key">大小</span>
              <span class="preview-meta-val" id="previewSize">—</span>
            </div>
            <div class="preview-meta-item">
              <span class="preview-meta-key">类型</span>
              <span class="preview-meta-val" id="previewType">—</span>
            </div>
            <div class="preview-meta-item">
              <span class="preview-meta-key">上传时间</span>
              <span class="preview-meta-val" id="previewCreated">—</span>
            </div>
          </div>
        </div>

        <div class="preview-section preview-actions-section">
          <button class="preview-delete-btn" id="previewDeleteBtn">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
              <path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
            </svg>
            <span>删除文件</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 图片全屏查看器（lightbox） -->
  <div id="lightboxOverlay" class="lightbox-overlay" style="display:none">
    <img class="lightbox-image" id="lightboxImg">
    <div class="lightbox-toolbar">
      <button class="lightbox-btn" id="lbZoomOut" title="缩小 (-)">−</button>
      <select class="lightbox-zoom-select" id="lbZoomSelect">
        <option value="0.25">25%</option>
        <option value="0.5">50%</option>
        <option value="0.75">75%</option>
        <option value="1" selected>100%</option>
        <option value="1.5">150%</option>
        <option value="2">200%</option>
        <option value="3">300%</option>
        <option value="4">400%</option>
      </select>
      <button class="lightbox-btn" id="lbZoomIn" title="放大 (+)">+</button>
      <button class="lightbox-btn" id="lbRotate" title="旋转 90°">↻</button>
      <button class="lightbox-btn lightbox-close" id="lbClose" title="关闭 (ESC)">✕</button>
    </div>
  </div>

  <!-- 视频播放器模态框 -->
  <div id="videoPlayerModal" class="modal">
    <span class="modal-close" id="closeVideoPlayer">&times;</span>
    <video class="video-player" id="videoPlayer" controls playsinline>
      您的浏览器不支持视频播放
    </video>
    <div class="modal-footer">
      <span id="videoFileName"></span>
      <a href="#" class="btn-preview-download" id="videoDownloadBtn" target="_blank">
        <svg viewBox="0 0 24 24"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        下载
      </a>
    </div>
  </div>

  <!-- 拖拽上传区域 -->
  <div id="dropZone" class="drop-zone">
    <div class="drop-zone-content">
      <svg viewBox="0 0 24 24"><path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM14 13v4h-4v-4H7l5-5 5 5h-3z"/></svg>
      <p>将文件拖拽到此处上传</p>
      <span class="drop-hint">支持单个或多个文件</span>
    </div>
  </div>

  <!-- 预览-文件夹选择器（修改位置） -->
  <div id="previewFolderPicker" class="modal">
    <div class="modal-dialog modal-sm">
      <div class="modal-header">
        <h3>选择位置</h3>
        <button class="modal-close-btn" id="closePreviewFolderPicker">&times;</button>
      </div>
      <div class="modal-body">
        <div class="folder-tree" id="previewFolderTree">
          <div class="folder-item root" data-id="">
            <span class="folder-icon">📂</span>
            <span class="folder-name">全部文件（根目录）</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn" id="cancelPreviewFolderBtn">取消</button>
        <button class="btn btn-primary" id="confirmPreviewFolderBtn">确定</button>
      </div>
    </div>
  </div>

  <!-- 移动文件弹窗 -->
  <div id="moveModal" class="modal">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3>移动到</h3>
        <button class="modal-close-btn" id="closeMoveModal">&times;</button>
      </div>
      <div class="modal-body">
        <div class="folder-tree" id="folderTree">
          <div class="folder-item root" data-id="">
            <span class="folder-icon">&#128193;</span>
            <span class="folder-name">全部文件</span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn" id="cancelMoveBtn">取消</button>
        <button class="btn btn-primary" id="confirmMoveBtn">移动</button>
      </div>
    </div>
  </div>

  <!-- 重命名弹窗 -->
  <div id="renameModal" class="modal">
    <div class="modal-dialog modal-sm">
      <div class="modal-header">
        <h3>重命名</h3>
        <button class="modal-close-btn" id="closeRenameModal">&times;</button>
      </div>
      <div class="modal-body">
        <input type="text" id="renameInput" class="form-input" placeholder="请输入新名称">
      </div>
      <div class="modal-footer">
        <button class="btn" id="cancelRenameBtn">取消</button>
        <button class="btn btn-primary" id="confirmRenameBtn">确定</button>
      </div>
    </div>
  </div>

  <!-- 分享弹窗 -->
  <div id="shareModal" class="modal">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3>创建分享链接</h3>
        <button class="modal-close-btn" id="closeShareModal">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <label>过期时间</label>
          <select id="shareExpire" class="form-input">
            <option value="">永不过期</option>
            <option value="1">1天后过期</option>
            <option value="7">7天后过期</option>
            <option value="30">30天后过期</option>
          </select>
        </div>
        <div class="form-group">
          <label>访问密码（可选）</label>
          <input type="password" id="sharePassword" class="form-input" placeholder="留空则无需密码">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn" id="cancelShareBtn">取消</button>
        <button class="btn btn-primary" id="createShareBtn">创建链接</button>
      </div>
    </div>
  </div>

  <script src="/js/filebrowser.js?v=20260707-1"></script>
</body>
</html>